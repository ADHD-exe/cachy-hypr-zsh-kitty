#=============================== (6)  KITTY TERMINAL  =============================== 
#  Guard — only define the kitty-specific bits when we're actually in kitty
_in_kitty() { [[ "$TERM" == "xterm-kitty" || -n "$KITTY_WINDOW_ID" ]]; }
# `kitten` is the standalone binary (kitty >= 0.29). Fall back to the old form.
if (( $+commands[kitten] )); then
  alias kt='kitten'
else
  alias kt='kitty +kitten'
fi
#  SSH / remote 
alias kssh='kitten ssh'
# without shell integration
alias kssh-bare='kitten ssh --kitten=no-shell-integration'
# Force a re-push of terminfo/config even if kitty thinks the host is current.
alias kssh-fresh='kitten ssh --force-1st-hop'
# Copy to the *local* clipboard from inside an SSH session (OSC 52).
alias kcopy='kitten clipboard'
alias kpaste='kitten clipboard --get-clipboard'
# Fast file transfer over the existing kitty ssh connection — no scp/rsync,
# no second auth. Works in both directions.
#   ktransfer remote.txt .          (pull)
#   ktransfer --direction=upload local.txt /remote/path
alias ktransfer='kitten transfer'
# Config management
export KITTY_CONFIG_DIR="${KITTY_CONFIG_DIR:-$HOME/.config/kitty}"
alias kconf='${EDITOR:-nvim} "$KITTY_CONFIG_DIR/kitty.conf"'
alias kconf-dir='cd "$KITTY_CONFIG_DIR"'
# Reload config in every running kitty instance (kitty listens for SIGUSR1).
alias kreload='pkill -USR1 -x kitty && echo "kitty config reloaded"'
# Show the fully-resolved config, including every include/theme override.
alias kconf-dump='kitty --debug-config'
alias kconf-check='kitty --debug-config | head -50'
# Diff your config against kitty's defaults — great for auditing cruft.
kconf-diff() {
  local tmp; tmp="$(mktemp)"
  kitty +runpy 'from kitty.config import commented_out_default_config; print(commented_out_default_config())' > "$tmp" 2>/dev/null
  kitten diff "$tmp" "$KITTY_CONFIG_DIR/kitty.conf"
  rm -f "$tmp"
}
alias ktheme='kitten themes'
alias ktheme-dark='kitten themes --reload-in=all'
alias kfont='kitten choose-fonts'          # kitty >= 0.33
alias kicons='kitten icat --help'
# List installed themes without launching the picker.
alias ktheme-ls='kitten themes --dump-theme 2>/dev/null | head -1; ls ~/.config/kitty/*.conf'
#  Kittens you'll actually use daily
# Images in the terminal, at native resolution.
alias icat='kitten icat'
alias kimg='kitten icat --align=left'
alias kimg-clear='kitten icat --clear'
# Preview every image in the current dir, scaled to fit.
alias kimgs='kitten icat --scale-up --place=80x40@0x0'
# Side-by-side diff with syntax highlighting and image support.
alias kdiff='kitten diff'
# ripgrep with clickable hyperlinks — click a result, it opens in $EDITOR.
alias kgrep='kitten hyperlinked_grep'
alias krg='kitten hyperlinked_grep'
# Unicode / emoji picker.
alias kuni='kitten unicode_input'
# Ask kitty to open a path/URL the way it would on click.
alias kopen='kitty +open'
# Desktop notification from the terminal (survives over SSH).
# Usage: knotify "Build done" "all 400 tests green"
knotify() { kitten notify "${1:-Notice}" "${2:-}"; }
# Run a long command and notify when it finishes.
# Usage: kwatch make -j16
kwatch() {
  "$@"
  local rc=$?
  kitten notify --urgency $(( rc == 0 ? 0 : 2 )) \
    "$([[ $rc -eq 0 ]] && echo '✓ done' || echo "✗ failed ($rc)")" "$*"
  return $rc
}
# Remote control  (requires in kitty.conf:)
#      allow_remote_control yes
#      listen_on unix:@mykitty
#    and start kitty with:  kitty -o allow_remote_control=yes
alias kc='kitty @ --to unix:@mykitty'
alias kls='kitty @ --to unix:@mykitty ls'                      # JSON tree of windows/tabs
alias ktree='kitty @ --to unix:@mykitty ls | jq -r ".[].tabs[].windows[].title"'
# Font size on the fly.
alias kfs='kitty @ --to unix:@mykitty set-font-size'           # kfs 14
alias kfs+='kitty @ --to unix:@mykitty set-font-size --increment 1'
alias kfs-='kitty @ --to unix:@mykitty set-font-size --increment -1'
alias kfs0='kitty @ --to unix:@mykitty set-font-size 0'        # reset to config value
# Opacity — needs `dynamic_background_opacity yes` in kitty.conf.
alias kop='kitty @ --to unix:@mykitty set-background-opacity'  # kop 0.85
alias kop-solid='kitty @ --to unix:@mykitty set-background-opacity 1'
alias kop-glass='kitty @ --to unix:@mykitty set-background-opacity 0.75'
# Live color changes without touching the config file.
# Usage: kcolors ~/.config/kitty/themes/catppuccin-mocha.conf
alias kcolors='kitty @ --to unix:@mykitty set-colors --all --configured'
alias kcolors-reset='kitty @ --to unix:@mykitty set-colors --reset'
# Type into another window, broadcast to all windows, etc.
alias kbroadcast='kitten broadcast'
alias ktitle='kitty @ --to unix:@mykitty set-tab-title'
alias kwtitle='kitty @ --to unix:@mykitty set-window-title'
# Spawn things into the current kitty instance.
alias ksplit='kitty @ --to unix:@mykitty launch --location=vsplit --cwd=current'
alias khsplit='kitty @ --to unix:@mykitty launch --location=hsplit --cwd=current'
alias ktab='kitty @ --to unix:@mykitty launch --type=tab --cwd=current'
alias koverlay='kitty @ --to unix:@mykitty launch --type=overlay'
# Scrollback of the current window straight into $PAGER / a file.
alias kscroll='kitty @ --to unix:@mykitty get-text --extent=all'
kscroll-save() { kitty @ --to unix:@mykitty get-text --extent=all > "${1:-$HOME/kitty-scrollback-$(date +%F-%H%M%S).log}"; }
# Launching — Hyprland window rules key off --class, so give things classes
# Reuse one process for every window — much lighter on RAM.
alias k='kitty --single-instance'
alias kdetach='kitty --single-instance --detach'
# Dedicated classes to target from hyprland.conf windowrulev2.
alias kfloat='kitty --class kitty-float --single-instance'
alias kscratch='kitty --class kitty-scratch --single-instance'
alias kbig='kitty -o font_size=18 --class kitty-present'
# Named session layouts: ~/.config/kitty/sessions/<name>.conf
# Usage: ksession dev
ksession() {
  local f="$KITTY_CONFIG_DIR/sessions/${1:?usage: ksession <name>}.conf"
  [[ -r "$f" ]] || { print -u2 "no session: $f"; return 1; }
  kitty --session "$f"
}
alias ksession-ls='ls -1 "$KITTY_CONFIG_DIR/sessions/" 2>/dev/null | sed "s/\.conf$//"'
# Save the current layout as a session file you can edit.
ksession-save() {
  local name="${1:?usage: ksession-save <name>}"
  mkdir -p "$KITTY_CONFIG_DIR/sessions"
  kitty @ --to unix:@mykitty ls > "$KITTY_CONFIG_DIR/sessions/$name.json"
  echo "raw layout dumped to $KITTY_CONFIG_DIR/sessions/$name.json (hand-convert to .conf)"
}
# Panel kitten — bar/wallpaper-style windows via wlr-layer-shell. Works on
# Hyprland. Handy for a system-monitor strip.
# Usage: kpanel top 2 btop
kpanel() {
  local edge="${1:-top}" lines="${2:-2}"; shift 2 2>/dev/null
  kitten panel --edge="$edge" --lines="$lines" "${@:-btop}"
}
alias kpanel-top='kitten panel --edge=top --lines=2'
alias kpanel-bg='kitten panel --edge=background'
#  Hyprland glue
alias hyprkitty='hyprctl clients -j | jq -r ".[] | select(.class|test(\"kitty\")) | \"\(.class)\t\(.title)\t\(.workspace.name)\""'
alias hyprkitty-count='hyprctl clients -j | jq "[.[] | select(.class|test(\"kitty\"))] | length"'
# Move the focused kitty window to a workspace without leaving the keyboard.
alias kmove='hyprctl dispatch movetoworkspace'
#  CachyOS / Arch maintenance
alias kitty-ver='kitty --version'
alias kitty-update='paru -S kitty'
alias kitty-git='paru -S kitty-git'
alias kitty-files='pacman -Ql kitty | less'
alias kitty-deps='pactree -d1 kitty'
# Kitty's diff.
alias kpacdiff='sudo DIFFPROG="kitten diff" pacdiff'
#=============================== (7) NMAP   =============================== 
alias nmap_open_ports="nmap --open"
alias nmap_list_interfaces="nmap --iflist"
alias nmap_slow="sudo nmap -sS -v -T1"
alias nmap_fin="sudo nmap -sF -v"
alias nmap_full="sudo nmap -sS -T4 -PE -PP -PS80,443 -PY -g 53 -A -p1-65535 -v"
alias nmap_check_for_firewall="sudo nmap -sA -p1-65535 -v -T4"
alias nmap_ping_through_firewall="nmap -PS -PA"
alias nmap_fast="nmap -F -T5 --version-light --top-ports 300"
alias nmap_detect_versions="sudo nmap -sV -p1-65535 -O --osscan-guess -T4 -Pn"
alias nmap_check_for_vulns="nmap --script=vuln"
alias nmap_full_udp="sudo nmap -sS -sU -T4 -A -v -PE -PS22,25,80 -PA21,23,80,443,3389 "
alias nmap_traceroute="sudo nmap -sP -PE -PS22,25,80 -PA21,23,80,3389 -PU -PO --traceroute "
alias nmap_full_with_scripts="sudo nmap -sS -sU -T4 -A -v -PE -PP -PS21,22,23,25,80,113,31339 -PA80,113,443,10042 -PO --script all "
alias nmap_web_safe_osscan="sudo nmap -p 80,443 -O -v --osscan-guess --fuzzy "
alias nmap_ping_scan="nmap -n -sP"
