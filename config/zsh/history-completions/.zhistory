# ========================= HISTORY + SHELL OPTIONS =========================
# Moved here out of apps-plugins/.zplugins, which is for third-party tool
# integration — these are core zsh settings and belong with the history dir.

export HISTFILE=$ZDOTDIR/history-completions/zsh/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

# share_history already implies inc_append_history and append_history, and
# hist_ignore_all_dups supersedes hist_ignore_dups — so neither is repeated.
setopt share_history          # live-sync history between open shells
setopt hist_ignore_all_dups   # drop older duplicates of a repeated command
setopt hist_ignore_space      # leading space keeps a command out of history
setopt hist_reduce_blanks     # normalize whitespace before saving
setopt hist_save_no_dups      # never write a duplicate to $HISTFILE
setopt hist_verify            # expand !! into the buffer instead of running it
setopt hist_expire_dups_first # trim duplicates before unique entries

# Shell behaviour (not history, but core zsh — kept out of the plugin file)
setopt auto_cd                # `foo/` alone cds into foo/
